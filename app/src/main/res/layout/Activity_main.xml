<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView android:id="@+id/fotoView"
        android:layout_width="250dp" android:layout_height="250dp"
        android:layout_gravity="center"
        android:src="@mipmap/ic_launcher"
        android:layout_marginTop="20dp"/>

    <Button android:id="@+id/btnPilihFoto"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="1. PILIH FOTO DARI GALERI"/>

    <EditText android:id="@+id/inputTeks"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Ketik teks di sini (suara cowok)"
        android:text="Halo, ini foto aku bisa bicara!"/>

    <Button android:id="@+id/btnPilihAudio"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="2. ATAU PILIH AUDIO MP3 DARI HP"
        android:layout_marginTop="10dp"/>

    <Button android:id="@+id/btnBicara"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="3. BIKIN FOTO BICARA"
        android:layout_marginTop="20dp"
        android:backgroundTint="#00C853"/>

</LinearLayout>
